# Modèle de infra/.env pour l'environnement local. Ne jamais versionner infra/.env.
# Le plus simple : ./generer-env.sh, qui recopie ce modèle en remplaçant chaque « a-generer » par une valeur aléatoire.
# Les mêmes variables servent au back-end lancé sur le poste (set -a; source infra/.env; set +a).

# PostgreSQL : superutilisateur de l'image et rôles du M0 (voir postgres/initdb).
ACU_PG_SUPERUSER_PASSWORD=a-generer
ACU_DB_OWNER_PASSWORD=a-generer
ACU_DB_APP_PASSWORD=a-generer
ACU_DB_PLATFORM_PASSWORD=a-generer
ACU_DB_AUDIT_PASSWORD=a-generer
ACU_KEYCLOAK_DB_PASSWORD=a-generer

# Keycloak : administrateur de la console locale et secrets des clients des realms.
ACU_KEYCLOAK_ADMIN_USER=admin-local
ACU_KEYCLOAK_ADMIN_PASSWORD=a-generer
ACU_KEYCLOAK_BFF_SECRET=a-generer
ACU_KEYCLOAK_EQUIPE_BFF_SECRET=a-generer
ACU_KEYCLOAK_CONFIRM_SECRET=a-generer
ACU_KEYCLOAK_ADMIN_SECRET=a-generer

# Adresses locales (D-26) : application Angular (npm start) sur 4220, back-end (profil local) sur 8086.
ACU_PUBLIC_URL=http://localhost:4220
ACU_HTTP_PORT=8086
ACU_BACKEND_INTERNAL_URL=http://host.docker.internal:8086
ACU_KEYCLOAK_URL=http://localhost:8180
ACU_DB_URL=jdbc:postgresql://localhost:5432/afrikcareunited
ACU_SMTP_HOST=localhost
ACU_SMTP_PORT=1025
ACU_SMTP_FROM=no-reply@afrikcareunited.example

# Environnement affiché par l'application (bandeau « données fictives » hors production).
ACU_ENVIRONMENT=development
ACU_DEMO_DATA=true
